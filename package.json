{
  "name": "monolith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Confidential treasury + on-chain capped AI agent on Stellar testnet (HackMeridian 2026).",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "postinstall": "npm run build -w stellar-confidential-token-sdk",
    "ct:deploy": "tsx scripts/deploy-ct.ts",
    "ct:e2e": "tsx scripts/e2e-ct.ts",
    "ct:auditor": "tsx scripts/deploy-auditor.ts",
    "ct:withdraw-to-contract": "tsx scripts/withdraw-to-contract.ts",
    "ct:register-member": "tsx scripts/register-member.ts",
    "dev": "npm run dev -w @monolith/app",
    "build": "npm run build -w @monolith/app",
    "hero:video": "bash scripts/hero-video.sh",
    "film": "bash scripts/film.sh"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^14.2.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
