# Copier vers app/.env.local (Next.js lit les variables depuis le dossier app/).
# Aucun secret ne doit être commité.

NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_USDC_SAC=
NEXT_PUBLIC_SMART_ACCOUNT_ID=
NEXT_PUBLIC_CT_CONTRACT_ID=
AGENT_SECRET_KEY=          # server-only, jamais NEXT_PUBLIC
LLM_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b   # modèle Groq du planner (vérifié via /openai/v1/models le 2026-10-25)

# x402 (option B) — toutes facultatives, valeurs par défaut dans app/lib/x402/config.ts
X402_FACILITATOR_URL=https://x402.org/facilitator   # doit annoncer stellar:testnet dans GET /supported
X402_PAY_TO=                  # compte G qui encaisse (trustline USDC requise) ; défaut : alice
X402_RESOURCE_BASE_URL=       # base de la route premium vue par l'agent ; défaut : origine de /api/intent
